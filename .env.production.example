# ================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - MM IMPRESIONES
# ================================================================
# Este archivo es una plantilla para configurar el .env en producción
# Reemplaza los valores de ejemplo con tus credenciales reales

# ---- APLICACIÓN ----
APP_NAME="MM Impresiones"
APP_ENV=production
APP_KEY=base64:GENERAR_NUEVA_KEY_CON_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://tu-dominio.cl

# ---- IDIOMA Y ZONA HORARIA ----
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL
APP_TIMEZONE=America/Santiago

# ---- BASE DE DATOS ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mm_impresiones_prod
DB_USERNAME=tu_usuario_mysql
DB_PASSWORD=tu_password_segura

# ---- SESIONES Y CACHÉ ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- CORREO ELECTRÓNICO ----
# Recomendado: Usar un servicio de emails transaccionales
# Opciones: Gmail SMTP, SendGrid, Mailgun, Amazon SES, etc.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-password-de-aplicacion
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contacto@tu-dominio.cl"
MAIL_FROM_NAME="MM Impresiones"

# ---- TRANSBANK WEBPAY PLUS (PRODUCCIÓN) ----
# ⚠️ IMPORTANTE: Estos datos te los entregará Transbank tras contratar el servicio
TRANSBANK_COMMERCE_CODE=tu_codigo_comercio_real
TRANSBANK_API_KEY=tu_api_key_de_produccion_muy_larga
TRANSBANK_ENVIRONMENT=production

# ---- ALMACENAMIENTO DE ARCHIVOS ----
FILESYSTEM_DISK=public

# ---- LOGS ----
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---- SEGURIDAD ----
# Encriptación de sesiones (recomendado en producción)
SESSION_ENCRYPT=true

# ================================================================
# NOTAS IMPORTANTES PARA PRODUCCIÓN:
# ================================================================
# 
# 1. NUNCA subas el archivo .env a Git
# 2. Genera una nueva APP_KEY con: php artisan key:generate
# 3. Configura un certificado SSL (HTTPS) en tu servidor
# 4. Cambia APP_DEBUG=false para ocultar errores a usuarios
# 5. Configura backups automáticos de la base de datos
# 6. Activa el firewall del servidor
# 7. Optimiza Laravel en producción:
#    - php artisan config:cache
#    - php artisan route:cache
#    - php artisan view:cache
#    - php artisan optimize
# 
# ================================================================
